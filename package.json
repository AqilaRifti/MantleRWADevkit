{
    "name": "mantle-rwa-sdk",
    "version": "0.1.0",
    "private": true,
    "packageManager": "pnpm@9.15.4",
    "description": "Comprehensive SDK for Real-World Asset tokenization on Mantle Network",
    "license": "MIT",
    "workspaces": [
        "packages/*",
        "examples/*",
        "docs"
    ],
    "scripts": {
        "build": "turbo run build",
        "test": "turbo run test",
        "lint": "turbo run lint",
        "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,sol}\"",
        "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,sol}\"",
        "clean": "turbo run clean && rm -rf node_modules",
        "prepare": "husky"
    },
    "devDependencies": {
        "@changesets/cli": "^2.27.1",
        "@types/node": "^20.11.0",
        "eslint": "^8.56.0",
        "husky": "^9.0.11",
        "lint-staged": "^15.2.0",
        "prettier": "^3.2.4",
        "prettier-plugin-solidity": "^1.3.1",
        "turbo": "^2.0.0",
        "typescript": "^5.3.3"
    },
    "engines": {
        "node": ">=18.0.0"
    },
    "lint-staged": {
        "*.{ts,tsx,js,jsx}": [
            "eslint --fix",
            "prettier --write"
        ],
        "*.{json,md}": [
            "prettier --write"
        ],
        "*.sol": [
            "prettier --write"
        ]
    }
}